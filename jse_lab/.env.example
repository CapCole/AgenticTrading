# Copy to .env. Never commit .env.

# Only needed for --agent claude (costs API credits, from console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# How hard Claude thinks (low | medium | high | xhigh | max). Higher costs more.
CLAUDE_EFFORT=medium

# For --agent ollama (free, runs locally; install from ollama.com)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434
